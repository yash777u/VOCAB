{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/library.js": {
      "includeFiles": ["A1/**/*.xlsx", "A2/**/*.xlsx", "B1/**/*.xlsx", "B2/**/*.xlsx"]
    },
    "api/workbook.js": {
      "includeFiles": ["A1/**/*.xlsx", "A2/**/*.xlsx", "B1/**/*.xlsx", "B2/**/*.xlsx"]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}